{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"$(git rev-parse --show-toplevel)/.codex/hooks/look_before_gate.py\"",
            "statusMessage": "Checking for prior-art note",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
